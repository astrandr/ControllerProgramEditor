<Window x:Class="ControllerProgramEditor.NewProgramDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New Program"
        Width="300"
        Height="140"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <Label Content="Name:" Width="60"/>
            <TextBox x:Name="NameTextBox" Width="200" TextChanged="NameTextBox_TextChanged"/>
        </StackPanel>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,15,0,0">

            <Button Content="OK"
                    x:Name="OkButton"
                    Width="70"
                    IsDefault="True"
                    Click="Ok_Click"
                    IsEnabled="False"/>

            <Button Content="Cancel"
                    Width="70"
                    Margin="5,0,0,0"
                    IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
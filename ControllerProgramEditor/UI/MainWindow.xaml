<Window x:Class="ControllerProgramEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ControllerProgramEditor"
        mc:Ignorable="d"
        Title="Controller Program Editor" Height="450" Width="800">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Menu -->
            <RowDefinition Height="Auto"/>
            <!-- Toolbar -->
            <RowDefinition Height="*"/>
            <!-- Text area + Data area -->
            <RowDefinition Height="Auto"/>
            <!-- Status area + additional information -->
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Menu Grid.Row="0">

            <MenuItem Header="Controller">
                <MenuItem Header="_Connect" Click="Connect_Click"  IsEnabled="{Binding CanConnect, UpdateSourceTrigger=PropertyChanged}"/>
                <MenuItem Header="_Disconnect" Click="Disconnect_Click" IsEnabled="{Binding IsConnected}"/>
            </MenuItem>

            <MenuItem Header="_Program" IsEnabled="{Binding IsConnected}">
                <MenuItem Header="_New" Click="New_Click"/>
                <MenuItem Header="_Read" Click="ReadProgram_Click" IsEnabled="{Binding IsConnected}"/>
                <MenuItem Header="_Upload" Click="UploadProgram_Click" IsEnabled="{Binding CanUpload}"/>
            </MenuItem>

            <MenuItem Header="_Data" IsEnabled="{Binding IsConnected}">
                <MenuItem Header="_Read" IsEnabled="{Binding CanUploadReadData}" Click="ReadData_Click"/>
                <MenuItem Header="_Upload"  IsEnabled="{Binding CanUploadReadData}" Click="UploadData_Click"/>
            </MenuItem>
        </Menu>

        <ToolBar Grid.Row="1" ToolBarTray.IsLocked="True">
            <Button ToolTip="New" Click="New_Click">
                <Image Source="/UI/Icons/New.png" Width="24" Height="24"/>
            </Button>
            <Button ToolTip="Read Program"  IsEnabled="{Binding IsConnected}" Click="ReadProgram_Click">
                <Image Source="/UI/Icons/Open.png" Width="24" Height="24" />
            </Button>
            <Button ToolTip="Upload Program"  IsEnabled="{Binding CanUpload}" Click="UploadProgram_Click">
                <Image Source="/UI/Icons/Upload.png" Width="24" Height="24" />
            </Button>

            <Button ToolTip="Read Data" IsEnabled="{Binding CanUploadReadData}"  Click="ReadData_Click">
                <Image Source="/UI/Icons/ReadData.png" Width="24" Height="24" />
            </Button>

            <Button ToolTip="Upload Data" IsEnabled="{Binding CanUploadReadData}"  Click="UploadData_Click">
                <Image Source="/UI/Icons/UploadData.png" Width="24" Height="24" IsEnabled="{Binding CanUploadReadData}"/>
            </Button>
        </ToolBar>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="100"/>
                <ColumnDefinition Width="120" MinWidth="100"/>
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0" Text ="{Binding ProgramText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" AcceptsTab="True" FontFamily="Consolas" FontSize="14" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>


            <DataGrid Grid.Row="0" Grid.Column="1" ItemsSource="{Binding Rows, UpdateSourceTrigger=PropertyChanged}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False">

                <DataGrid.Resources>

                    <!-- Display mode -->
                    <Style TargetType="TextBlock" x:Key="RightAlignedText">
                        <Setter Property="TextAlignment" Value="Right"/>
                    </Style>

                    <!-- Edit mode -->
                    <Style TargetType="TextBox" x:Key="RightAlignedEdit">
                        <Setter Property="TextAlignment" Value="Right"/>
                    </Style>

                </DataGrid.Resources>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding Index}" IsReadOnly="True" ElementStyle="{StaticResource RightAlignedText}"/>
                    <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*" ElementStyle="{StaticResource RightAlignedText}" EditingElementStyle="{StaticResource RightAlignedEdit}"/>
                </DataGrid.Columns>

            </DataGrid>

        </Grid>

        <StatusBar Grid.Row="3">
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Connection: "/>
                    <TextBlock Text="{Binding ConnectionStatus}"/>
                </StackPanel>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem >
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Program: "/>
                    <TextBlock Text="{Binding ProgramName}"/>
                </StackPanel>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem Visibility="{Binding IsOperationInProgress, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Progress: "/>
                    <TextBlock Text="{Binding ProgressValue}"/>
                    <TextBlock Text="%"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

    </Grid>
</Window>
